VITE_API_URL=http://localhost:8080/api/v1

# Stripe, modo test: clave publicable (pk_test_...). Sin ella, el checkout usa tarjetas simuladas.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
