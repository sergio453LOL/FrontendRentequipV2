{
  "expo": {
    "name": "RentEquip",
    "slug": "rentequip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.rentequip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.rentequip.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "RentEquip usa la cámara para fotografiar el estado de la maquinaria al entregarla y al devolverla.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RentEquip usa tu ubicación para mostrarte maquinaria cerca de tu obra."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RentEquip necesita acceder a tus fotos para adjuntar el estado de la maquinaria cuando no puedes usar la cámara."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.startup.** { *; }"
          }
        }
      ]
    ],
    "scheme": "rentequip",
    "extra": {
      "eas": {
        "projectId": "13c29b2a-cecb-454d-9ca2-a2976bfbd6c2"
      }
    },
    "owner": "sergiorojas"
  }
}
